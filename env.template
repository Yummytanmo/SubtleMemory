# Standalone Evaluation Environment Template
#
# Usage:
#   cp env.template .env
#   edit .env with real keys
#
# Only evaluation-related variables are listed here. The local EverMemOS app,
# database, vectorize, rerank, and server settings are intentionally omitted.


# ===================
# Answer LLM
# ===================

# Used by answer generation in system configs.
ANSWER_LLM_API_KEY=
ANSWER_LLM_BASE_URL=https://openrouter.ai/api/v1
ANSWER_LLM_MODEL=gpt-4o-mini


# ===================
# Embedding
# ===================

# Used by systems that need OpenAI-compatible embeddings, including MIRIX.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Native MIRIX reads these names inside its subprocess environment.
# They may use the same values as EMBEDDING_API_KEY / EMBEDDING_BASE_URL.
MIRIX_EMBEDDING_API_KEY=
MIRIX_EMBEDDING_BASE_URL=https://api.openai.com/v1


# ===================
# Judge / Diagnosis LLM
# ===================

# Used by evaluator configs such as llm_judge.
JUDGE_LLM_API_KEY=
JUDGE_LLM_BASE_URL=https://openrouter.ai/api/v1
JUDGE_LLM_MODEL=gemini-3.1-pro-preview-thinking


# ===================
# Data Construction
# ===================

# Used by construction/user-related for case, session, and QA generation.
GENERATION_BASE_URL=
GENERATION_API_KEY=

# Used by construction/user-related for filtering generated cases and QAs.
FILTER_BASE_URL=
FILTER_API_KEY=

# Keep these relative to the repository root so construction scripts can run
# from the project root without host-specific absolute paths.
DATA_CONSTRUCTION_PERSONAMEM_INPUT_DIR=data/personamem-raw
DATA_CONSTRUCTION_USER_RELATED_OUTPUT_DIR=data/user-related

# Optional overrides for user-unrelated topic/domain classification utilities.
# If omitted, they fall back to the GENERATION_* values above when supported.
TOPIC_BASE_URL=
TOPIC_API_KEY=
TOPIC_MODEL=
TOPIC_REASONING_EFFORT=
DOMAIN_BASE_URL=
DOMAIN_API_KEY=
DOMAIN_MODEL=
DOMAIN_REASONING_EFFORT=


# ===================
# Online Memory Systems
# ===================

# Mem0
MEM0_API_KEY=
MEM0_HOST=https://api.mem0.ai

# Memos
MEMOS_KEY=

# MemU
MEMU_API_KEY=

# Zep
ZEP_API_KEY=

# EverMemOS hosted HTTP API
EVERMEMOS_API_KEY=
EVERMEMOS_API_URL=https://api.evermind.ai


# ===================
# Agent-Native Runtime Paths
# ===================

# Copy these to .env and adjust them to the target server.
# System YAMLs read these variables and do not carry host-specific paths.
OPENCLAW_ROOT=~/mem/agent/openclaw
OPENCLAW_CLI=~/mem/agent/openclaw/openclaw.mjs
OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
OPENCLAW_MEM0_PLUGIN_PATH=~/mem/mem_sys/mem0/openclaw
OPENCLAW_MEMOS_PLUGIN_DIR=~/mem/mem_sys/MemOS-Cloud-OpenClaw-Plugin
OPENCLAW_MEMOS_PLUGIN_PATH=~/mem/mem_sys/MemOS-Cloud-OpenClaw-Plugin/index.js
OPENCLAW_EVERMEMOS_PLUGIN_PATH=
MIRIX_ROOT=third_party/mirix
METACLAW_ROOT=~/mem/bench/agent/metaclaw

# A-Mem
# Vendored A-Mem repository used by evaluation/config/systems/amem.yaml.
AMEM_REPO_PATH=third_party/a-mem
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Use the model id on servers with HuggingFace access. On offline servers,
# set this to a local sentence-transformers/all-MiniLM-L6-v2 snapshot path.
AMEM_RETRIEVER_MODEL=all-MiniLM-L6-v2
# HuggingFace endpoint used when A-Mem/SentenceTransformer needs model metadata.
HF_ENDPOINT=https://hf-mirror.com
# Bounds each native A-Mem OpenAI call so one slow evolution request cannot
# block the entire add stage indefinitely. Increase on slower providers.
AMEM_OPENAI_TIMEOUT_SECONDS=45
# Native OpenAI SDK retries inside each A-Mem LLM call. Capped at 5 by the adapter.
AMEM_OPENAI_MAX_RETRIES=4

# Memobase
# Vendored Memobase repository used for local Docker Compose reproduction.
MEMOBASE_REPO_PATH=third_party/memobase
MEMOBASE_API_EXPORT_PORT=8019
MEMOBASE_PROJECT_URL=http://localhost:${MEMOBASE_API_EXPORT_PORT}/api/v1
MEMOBASE_PROJECT_ID=memobase_dev
MEMOBASE_API_KEY=replace_with_local_memobase_token
MEMOBASE_READBACK_INCLUDE_PROFILES=true

# Memobase server database/cache settings. The unprefixed aliases below are
# consumed directly by third_party/memobase/src/server/docker-compose.yml.
MEMOBASE_DATABASE_NAME=memobase
MEMOBASE_DATABASE_USER=memobase
MEMOBASE_DATABASE_PASSWORD=replace_with_local_database_password
MEMOBASE_DATABASE_LOCATION=./db/data
MEMOBASE_DATABASE_EXPORT_PORT=15432
MEMOBASE_REDIS_PASSWORD=replace_with_local_redis_password
MEMOBASE_REDIS_LOCATION=./db/redis/data
MEMOBASE_REDIS_EXPORT_PORT=16379
MEMOBASE_API_HOSTS=http://0.0.0.0:${MEMOBASE_API_EXPORT_PORT},http://localhost:${MEMOBASE_API_EXPORT_PORT},https://api.memobase.dev,https://api.memobase.cn
MEMOBASE_USE_CORS=false

DATABASE_NAME=${MEMOBASE_DATABASE_NAME}
DATABASE_USER=${MEMOBASE_DATABASE_USER}
DATABASE_PASSWORD=${MEMOBASE_DATABASE_PASSWORD}
DATABASE_LOCATION=${MEMOBASE_DATABASE_LOCATION}
DATABASE_EXPORT_PORT=${MEMOBASE_DATABASE_EXPORT_PORT}
REDIS_PASSWORD=${MEMOBASE_REDIS_PASSWORD}
REDIS_LOCATION=${MEMOBASE_REDIS_LOCATION}
REDIS_EXPORT_PORT=${MEMOBASE_REDIS_EXPORT_PORT}
API_EXPORT_PORT=${MEMOBASE_API_EXPORT_PORT}
PROJECT_ID=${MEMOBASE_PROJECT_ID}
ACCESS_TOKEN=${MEMOBASE_API_KEY}
API_HOSTS=${MEMOBASE_API_HOSTS}
USE_CORS=${MEMOBASE_USE_CORS}

# Memobase server LLM/embedding config. These MEMOBASE_* names override the
# vendored server's config.yaml fields.
MEMOBASE_LLM_API_KEY=
MEMOBASE_LLM_BASE_URL=https://api.openai.com/v1
MEMOBASE_BEST_LLM_MODEL=gpt-4o-mini
MEMOBASE_SUMMARY_LLM_MODEL=gpt-4o-mini
MEMOBASE_EMBEDDING_API_KEY=
MEMOBASE_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMOBASE_EMBEDDING_MODEL=text-embedding-3-small
MEMOBASE_EMBEDDING_DIM=1536


# ===================
# Optional TLS
# ===================

# Optional CA bundle path used by Memos/aiohttp requests when needed.
SSL_CERT_FILE=
